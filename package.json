{
  "name": "squeek-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "art": "node scripts/art.mjs",
    "server": "node --import tsx server/index.ts",
    "db:migrate": "node --import tsx server/migrate.ts",
    "test:browser": "node test/browser.mjs",
    "test:ranked": "node --import tsx test/ranked-browser.ts",
    "test:states": "node test/states-browser.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "pg": "^8.16.3",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.5",
    "wagmi": "^2.19.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
